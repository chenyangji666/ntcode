\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Architecture of a Mixture of Experts (MoE) model.} The gating network $G$ produces sparse weights $g_i$ for each expert $E_i$. Only the top-$k$ experts (solid purple arrows) are activated for each input, while others (dashed, near-zero weights) remain dormant. The output is the weighted sum of activated expert outputs: $y = \DOTSB \sum@ \slimits@ _{i \in \text  {TopK}} g_i \cdot E_i(\mathbf  {x})$.}}{16}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:moe_architecture}{{1}{16}{\textbf {Architecture of a Mixture of Experts (MoE) model.} The gating network $G$ produces sparse weights $g_i$ for each expert $E_i$. Only the top-$k$ experts (solid purple arrows) are activated for each input, while others (dashed, near-zero weights) remain dormant. The output is the weighted sum of activated expert outputs: $y = \sum _{i \in \text {TopK}} g_i \cdot E_i(\mathbf {x})$}{figure.caption.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Overview of MoE applications across healthcare domains.} The Mixture of Experts architecture has been applied to five major areas of healthcare AI: medical imaging (including computational pathology and radiology), clinical NLP and medical LLMs, drug discovery and genomics, electronic health record analysis, and multi-modal clinical decision support.}}{17}{figure.caption.2}\protected@file@percent }
\newlabel{fig:healthcare_overview}{{2}{17}{\textbf {Overview of MoE applications across healthcare domains.} The Mixture of Experts architecture has been applied to five major areas of healthcare AI: medical imaging (including computational pathology and radiology), clinical NLP and medical LLMs, drug discovery and genomics, electronic health record analysis, and multi-modal clinical decision support}{figure.caption.2}{}}
